{
  "name": "sop-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WhatsApp assistant that answers contractor questions from SOPs.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
