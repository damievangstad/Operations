# Server
PORT=8080
# Public HTTPS base URL of this service once deployed (used for Twilio signature checks)
PUBLIC_URL=

# OpenAI (leave blank to run in echo/plumbing-test mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Twilio (Phase 1 sandbox: only the auth token is needed, and only for signature validation)
TWILIO_AUTH_TOKEN=

# Who the assistant tells contractors to contact when it can't answer
ESCALATION_CONTACT=your manager

# Protects the /ask test endpoint once deployed. Set to any long random string in production.
# When set, /ask requires it via ?key=... or the x-admin-key header. Leave blank locally.
ADMIN_KEY=
